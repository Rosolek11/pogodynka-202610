<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Weather app{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap.min.css') }}">
    <style>
        body { background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=RJ57754"); }
        .weather-form { max-width: 760px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-light bg-light border-bottom mb-4" aria-label="Main navigation">
        <div class="container d-flex flex-wrap justify-content-start gap-3">
            <a class="navbar-brand fw-bold me-2" href="{{ path('app_location_index') }}">W App</a>
            <a class="nav-link" href="{{ path('app_location_index') }}">Locations</a>
            <a class="nav-link" href="{{ path('app_measurement_index') }}">Measurements</a>
        </div>
    </nav>
    <main class="container pb-4">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
    <script src="{{ asset('vendor/bootstrap.bundle.min.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
