{% extends 'base.html.twig' %}
{% block title %}Location index{% endblock %}
{% macro actions(row) %}
    {% if is_granted('ROLE_LOCATION_SHOW') %}
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_location_show', {id: row.id}) }}">show</a>
    {% endif %}
    {% if is_granted('ROLE_LOCATION_EDIT') %}
        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_location_edit', {id: row.id}) }}">edit</a>
    {% endif %}
    {% if is_granted('ROLE_LOCATION_DELETE') %}
        <a class="btn btn-sm btn-outline-danger" href="{{ path('app_location_confirm_delete', {id: row.id}) }}">delete</a>
    {% endif %}
{% endmacro %}
{% block body %}
<h1 class="mb-4">Location index</h1>
{% import _self as ui %}
{% include 'location/_list.html.twig' %}
{% if is_granted('ROLE_LOCATION_NEW') %}
<a class="btn btn-primary" href="{{ path('app_location_new') }}">Create new</a>
{% endif %}
{% endblock %}
