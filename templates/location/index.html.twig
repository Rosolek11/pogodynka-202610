{% extends 'base.html.twig' %}
{% block title %}Location index{% endblock %}
{% block body %}
<h1 class="mb-4">Location index</h1>
<div class="d-none d-md-block table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Id</th><th>City</th><th>Latitude</th><th>Longitude</th><th>Actions</th></tr></thead>
<tbody>
{% for row in locations %}<tr><td>{{ row.id }}</td><td>{{ row.city }}</td><td>{{ row.latitude }}</td><td>{{ row.longitude }}</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-secondary" href="{{ path('app_location_show', {'id': row.id}) }}">show</a>
<a class="btn btn-sm btn-outline-primary" href="{{ path('app_location_edit', {'id': row.id}) }}">edit</a>
<a class="btn btn-sm btn-outline-danger" href="{{ path('app_location_confirm_delete', {'id': row.id}) }}">delete</a></td></tr>{% else %}<tr><td colspan="5">No records found.</td></tr>{% endfor %}</tbody></table></div>
<div class="d-md-none">{% for row in locations %}<article class="card mb-3"><div class="card-body"><dl class="row mb-3"><dt class="col-6">Id</dt><dd class="col-6">{{ row.id }}</dd><dt class="col-6">City</dt><dd class="col-6">{{ row.city }}</dd><dt class="col-6">Latitude</dt><dd class="col-6">{{ row.latitude }}</dd><dt class="col-6">Longitude</dt><dd class="col-6">{{ row.longitude }}</dd></dl><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-secondary" href="{{ path('app_location_show', {'id': row.id}) }}">show</a>
<a class="btn btn-sm btn-outline-primary" href="{{ path('app_location_edit', {'id': row.id}) }}">edit</a>
<a class="btn btn-sm btn-outline-danger" href="{{ path('app_location_confirm_delete', {'id': row.id}) }}">delete</a></div></div></article>{% else %}<p>No records found.</p>{% endfor %}</div>
<a class="btn btn-primary" href="{{ path('app_location_new') }}">Create new</a>
{% endblock %}