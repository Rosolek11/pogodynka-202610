{% extends 'base.html.twig' %}
{% block title %}Edit Location{% endblock %}
{% block body %}
<h1 class="mb-4">Edit Location</h1>
{{ include('location/_form.html.twig', {'button_label': 'Update'}) }}
<div class="d-flex gap-3 mt-3">{% if is_granted('ROLE_LOCATION_INDEX') %}<a href="{{ path('app_location_index') }}">back to list</a>{% endif %}{% if is_granted('ROLE_LOCATION_DELETE') %}<a class="text-danger" href="{{ path('app_location_confirm_delete', {'id': location.id}) }}">Delete</a>{% endif %}</div>
{% endblock %}