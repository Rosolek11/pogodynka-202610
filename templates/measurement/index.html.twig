{% extends 'base.html.twig' %}
{% block title %}Measurement index{% endblock %}
{% macro actions(row) %}
    {% if is_granted('ROLE_MEASUREMENT_SHOW') %}
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_measurement_show', {id: row.id}) }}">show</a>
    {% endif %}
    {% if is_granted('ROLE_MEASUREMENT_EDIT') %}
        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_measurement_edit', {id: row.id}) }}">edit</a>
    {% endif %}
    {% if is_granted('ROLE_MEASUREMENT_DELETE') %}
        <a class="btn btn-sm btn-outline-danger" href="{{ path('app_measurement_confirm_delete', {id: row.id}) }}">delete</a>
    {% endif %}
{% endmacro %}
{% block body %}
<h1 class="mb-4">Measurement index</h1>
{% import _self as ui %}
{% include 'measurement/_list.html.twig' %}
{% if is_granted('ROLE_MEASUREMENT_NEW') %}
<a class="btn btn-primary" href="{{ path('app_measurement_new') }}">Create new</a>
{% endif %}
{% endblock %}
