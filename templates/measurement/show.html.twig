{% extends 'base.html.twig' %}
{% block title %}Measurement{% endblock %}
{% block body %}<h1>Measurement</h1><table class="table"><tbody><tr><th>Id</th><td>{{ measurement.id }}</td></tr><tr><th>Location</th><td>{{ measurement.location.city }}</td></tr><tr><th>Date</th><td>{{ measurement.date|date('d.m.Y') }}</td></tr><tr><th>Celsius</th><td>{{ measurement.celsius }}</td></tr><tr><th>Humidity (%)</th><td>{{ measurement.humidity }}</td></tr><tr><th>Pressure (hPa)</th><td>{{ measurement.pressure }}</td></tr><tr><th>Precipitation (mm)</th><td>{{ measurement.precipitation }}</td></tr></tbody></table><div class="d-flex gap-3"><a href="{{ path('app_measurement_index') }}">back to list</a><a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">edit</a><a class="text-danger" href="{{ path('app_measurement_confirm_delete', {'id': measurement.id}) }}">delete</a></div>{% endblock %}