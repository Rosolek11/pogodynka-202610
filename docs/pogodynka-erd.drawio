height="35" /></mxCell><mxCell id="many" value="0..N" style="text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="275" width="60" height="35" /></mxCell><mxCell id="rules" value="Kazdy wpis ma jedna miejscowosc. Miejscowosc moze miec 0 lub wiele wpisow.&lt;br&gt;UNIQUE (miejscowosc_id, czas_pomiaru). Temperatura zawsze w stopniach Celsjusza.&lt;br&gt;Wilgotnosc 0-100%, cisnienie &gt; 0, wiatr &gt;= 0. Wspolrzedne: szer. -90..90, dl. -180..180." style="text;html=1;align=left;verticalAlign=top;fontSize=18;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="540" width="960" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>